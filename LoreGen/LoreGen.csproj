<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LoreGen</RootNamespace>
    <AssemblyName>LoreGen</AssemblyName>
    <Version>0.12.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <NoWarn>$(NoWarn);CS1591;CS0649;CS0168;CS0219;CS0414;CS0169;CS0108;CS0660;CS0661;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Default data files, embedded as LoreGen.Resources.<filename> -->
    <EmbeddedResource Include="Resources\*.csv;Resources\*.txt" LogicalName="LoreGen.Resources.%(Filename)%(Extension)" />
    <Compile Remove="Properties\Resources.Designer.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <None Include="Properties\Resources.resx" />
    <Compile Remove="bin\**;obj\**" />
  </ItemGroup>

</Project>
