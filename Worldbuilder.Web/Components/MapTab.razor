@using System.Globalization
@using LoreGen.WorldDisplay
@using Worldbuilder.Web.Services
@implements IAsyncDisposable
@inject WorldSession Session
@inject IJSRuntime JS

<div class="map-layout">
    <div class="map-main">
        <div class="map-toolbar">
            <div class="breadcrumb">
                <button class="btn" disabled="@(!Map.CanZoomOut || detailing)" @onclick="ZoomOut">&larr; Back</button>
                <div class="crumbs">
                    <span class="trail">@string.Join(" › ", Map.Trail)</span>
                    <strong>@Map.Title</strong>
                </div>
                @if (Map.Zoom == MapZoom.Block)
                {
                    <div class="pan" role="group" aria-label="Move to the neighbouring block">
                        <button class="btn" title="West" aria-label="West" disabled="@(!Map.CanPan(-1, 0) || detailing)" @onclick="() => Pan(-1, 0)">&larr;</button>
                        <button class="btn" title="North" aria-label="North" disabled="@(!Map.CanPan(0, -1) || detailing)" @onclick="() => Pan(0, -1)">&uarr;</button>
                        <button class="btn" title="South" aria-label="South" disabled="@(!Map.CanPan(0, 1) || detailing)" @onclick="() => Pan(0, 1)">&darr;</button>
                        <button class="btn" title="East" aria-label="East" disabled="@(!Map.CanPan(1, 0) || detailing)" @onclick="() => Pan(1, 0)">&rarr;</button>
                    </div>
                }
            </div>
            <div class="map-options">
                <label>Colour by
                    <select value="@Map.Context" disabled="@Map.UseTiles" @onchange="OnContextChanged">
                        @foreach (var c in Map.AvailableContexts)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </label>
                <label class="check" title="Draw terrain tiles from the tileset image instead of colours"><input type="checkbox" checked="@Map.UseTiles" @onchange="OnTilesChanged" /> Tileset</label>
                <label class="check"><input type="checkbox" checked="@Map.HiDef" @onchange="OnHiDefChanged" /> High detail</label>
                @if (Map.SquaresCanHaveDetail)
                {
                    var missing = Map.SquaresWithoutDetail().Count;
                    <button class="btn" disabled="@(missing == 0 || detailing)" @onclick="GenerateDetails"
                            title="Make the finer detail inside every square of this block at once, and show it">
                        @(missing == 0 ? "Details generated" : "Generate details")
                    </button>
                }
            </div>
        </div>
        <div class="canvas-wrap">
            <canvas @ref="canvas" class="map-canvas" style="@CanvasStyle"></canvas>
        </div>
        <p class="hint">
            @if (detailing)
            {
                <span class="detailing" role="status">Adding detail&hellip;@(detailTotal > 0 ? $" {detailDone} of {detailTotal} squares" : "")</span>
            }
            else
            {
                <span>Squares are @Map.CellSize across.</span>
            }
            Click a square for details. Double-click to zoom into a continent, then a region, then ever smaller blocks down to 100 m.
        </p>
    </div>

    <aside class="map-side">
        <section class="card">
            <h3>Selected block</h3>
            @if (Map.Selected == null)
            {
                <p class="muted">Nothing selected.</p>
            }
            else
            {
                <dl class="info">
                    @foreach (var line in Map.Describe(Map.Selected))
                    {
                        <dt>@line.Label</dt>
                        <dd>@line.Value</dd>
                    }
                </dl>
            }
        </section>
        <section class="card">
            <h3>Legend</h3>
            <ul class="legend">
                @foreach (var entry in legend.Take(40))
                {
                    <li><span class="swatch" style="background:@entry.Hex"></span>@entry.Label</li>
                }
            </ul>
            @if (legend.Count > 40)
            {
                <p class="muted">…and @(legend.Count - 40) more.</p>
            }
        </section>
    </aside>
</div>

@code {
    private ElementReference canvas;
    private IJSObjectReference module;
    private DotNetObjectReference<MapTab> self;
    private bool dirty = true;
    private bool attached;
    private bool detailing; // making the detail of a block being zoomed into, or of every square ("Generate details")
    private int detailDone, detailTotal;
    private List<LegendEntry> legend = new();
    private (int X, int Y, int Width, int Height) bounds;

    private MapView Map => Session.Map;

    private string CanvasStyle
    {
        get
        {
            var w = bounds.Width <= 0 ? 1 : bounds.Width;
            var h = bounds.Height <= 0 ? 1 : bounds.Height;
            var ratio = ((double)w / h).ToString("0.####", CultureInfo.InvariantCulture);
            return $"aspect-ratio:{w}/{h}; max-width:calc(75vh * {ratio});";
        }
    }

    protected override void OnInitialized()
    {
        Session.Changed += OnWorldChanged;
        Prepare();
    }

    private void OnWorldChanged()
    {
        dirty = true;
        Prepare();
        InvokeAsync(StateHasChanged);
    }

    private void Prepare()
    {
        bounds = Map.GetBounds();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/map.js");
            self = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("attach", canvas, self);
            attached = true;
        }
        if (attached && dirty)
        {
            dirty = false;
            var (rects, entries) = Map.Build();
            bounds = Map.GetBounds();
            legend = entries;
            await module.InvokeVoidAsync("draw", canvas, bounds.Width, bounds.Height, rects, Map.SelectedRect());
            StateHasChanged(); // legend + aspect ratio
        }
    }

    [JSInvokable]
    public async Task OnMapPointer(double fx, double fy, bool doubleClick)
    {
        var block = Map.BlockAt(fx, fy);
        if (block == null) return;
        if (doubleClick && Map.CanZoomInto(block))
        {
            if (detailing) return;
            await WithDetail(Map.NeedsDetail(block), () => Map.ZoomInto(block));
            return;
        }
        Map.Select(block);
        await module.InvokeVoidAsync("setSelection", canvas, Map.SelectedRect());
        StateHasChanged();
    }

    private void Redraw()
    {
        dirty = true;
        Prepare();
        StateHasChanged();
    }

    // Makes the detail of every square in the current block view, a row at a time so the page can show progress, then
    // shows it (High detail draws each square's detail)
    private async Task GenerateDetails()
    {
        var squares = Map.SquaresWithoutDetail();
        if (squares.Count == 0 || detailing) return;
        detailing = true;
        detailTotal = squares.Count;
        detailDone = 0;
        try
        {
            for (int i = 0; i < squares.Count; i++)
            {
                if (i % 10 == 0)
                {
                    StateHasChanged();
                    await Task.Delay(1);
                }
                Map.MakeDetail(squares[i]);
                detailDone = i + 1;
            }
        }
        finally
        {
            detailing = false;
            detailTotal = 0;
        }
        Map.HiDef = true;
        Redraw();
    }

    private Task Pan(int dx, int dy) => WithDetail(Map.PanNeedsDetail(dx, dy), () => Map.Pan(dx, dy));

    // Runs a change of view, first showing that detail is being made if it has to be (so the page can say so before the
    // work starts), then redraws
    private async Task WithDetail(bool needsDetail, Action change)
    {
        if (needsDetail)
        {
            detailing = true;
            StateHasChanged();
            await Task.Delay(1);
        }
        try { change(); }
        finally { detailing = false; }
        Redraw();
    }

    private void ZoomOut()
    {
        Map.ZoomOut();
        Redraw();
    }

    private void OnContextChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<MapContext>(e.Value?.ToString(), out var ctx)) Map.Context = ctx;
        Redraw();
    }

    private void OnTilesChanged(ChangeEventArgs e)
    {
        Map.UseTiles = e.Value is bool b && b;
        Redraw();
    }

    private void OnHiDefChanged(ChangeEventArgs e)
    {
        Map.HiDef = e.Value is bool b && b;
        Map.Select(null);
        Redraw();
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnWorldChanged;
        if (module != null)
        {
            try { await module.InvokeVoidAsync("detach", canvas); await module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        self?.Dispose();
    }
}
