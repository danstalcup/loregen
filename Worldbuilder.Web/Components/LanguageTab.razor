@using Worldbuilder.Web.Services
@using LoreGen.Lang
@implements IDisposable
@inject WorldSession Session

<section class="card">
    <div class="row">
        <label>Style
            <select @bind="style">
                <option value="@LanguageStyle.Common">Common</option>
                <option value="@LanguageStyle.Phonetic">Phonetic</option>
            </select>
        </label>
        <button class="btn primary" @onclick="NewLanguage">New random language</button>
        <button class="btn" @onclick="Describe">Describe language</button>
    </div>
    <div class="row">
        <label>Naming
            <select @bind="kind">
                @foreach (var k in Enum.GetValues<NameKind>())
                {
                    <option value="@k">@k</option>
                }
            </select>
        </label>
        <button class="btn" @onclick="Names">Generate 100 names</button>
        <button class="btn" @onclick="Words">Generate 50 words</button>
    </div>
    @if (!string.IsNullOrEmpty(title))
    {
        <h3>@title</h3>
    }
    <pre class="output">@output</pre>
</section>

@code {
    private string title = "";
    private string output = "Generate a language to begin.";
    private LanguageStyle style = LanguageStyle.Common;
    private NameKind kind = NameKind.Region;

    protected override void OnInitialized() => Session.Changed += OnChanged;
    private void OnChanged() { title = ""; output = "Generate a language to begin."; InvokeAsync(StateHasChanged); }
    public void Dispose() => Session.Changed -= OnChanged;

    private void NewLanguage()
    {
        Session.TestLanguage = Session.Engine.Language.GetRandomLanguage(style);
        Describe();
    }

    private void Describe()
    {
        var lang = Session.GetTestLanguage();
        title = lang.LanguageName;
        output = lang.ToString();
    }

    private void Names()
    {
        var lang = Session.GetTestLanguage();
        title = $"{lang.LanguageName}: {kind} names";
        output = string.Join("\n", Enumerable.Range(0, 100).Select(_ => lang.GetName(kind)));
    }

    private void Words()
    {
        var lang = Session.GetTestLanguage();
        title = $"{lang.LanguageName}: {kind} words";
        output = string.Join("\n", Enumerable.Range(0, 50).Select(_ => lang.GetWord(kind)));
    }
}
