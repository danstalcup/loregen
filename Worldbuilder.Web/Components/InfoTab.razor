@using LoreGen.WorldGen
@using Worldbuilder.Web.Services
@implements IDisposable
@inject WorldSession Session

@{
    var world = Session.Engine.World;
    var root = world.WorldBlock;
}

<div class="grid-2">
    <section class="card">
        <h3>World</h3>
        <dl class="info">
            <dt>Seed</dt><dd>@Session.Seed</dd>
            <dt>Generator</dt><dd>@GeneratorName (version @(world.GeneratorVersion))</dd>
            <dt>Options</dt><dd>@SettingsText</dd>
            <dt>Grid size</dt><dd>@root.Width &times; @root.Height blocks</dd>
            <dt>Continents</dt><dd>@world.Continents.Count</dd>
            <dt>Oceans</dt><dd>@world.Oceans.Count</dd>
            <dt>Features</dt><dd>@world.Features.Count</dd>
        </dl>
    </section>
    <section class="card">
        <h3>Oceans</h3>
        <table>
            <thead><tr><th>Name</th><th class="num">Blocks</th></tr></thead>
            <tbody>
                @foreach (var o in world.Oceans)
                {
                    <tr><td>@o.Name</td><td class="num">@o.OceanArea.BlocksList.Count</td></tr>
                }
            </tbody>
        </table>
    </section>
</div>

@if (Session.LastCompletedRun is { } log)
{
    <details class="card generation-log">
        <summary>Generation log <span class="muted">&mdash; @log.StepCount steps, @GenerationProgress.Millis(log.WorkTime) of work, @($"{log.Elapsed.TotalSeconds:0.0}") s in all</span></summary>
        <table>
            <thead><tr><th>Step</th><th class="num">Time</th><th class="num">Share</th></tr></thead>
            <tbody>
                @for (int i = 0; i < log.StepCount; i++)
                {
                    <tr>
                        <td>@log.StepNames[i]</td>
                        <td class="num">@GenerationProgress.Millis(log.Durations[i])</td>
                        <td class="num">@Share(log.Durations[i], log.WorkTime)</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="hint">The difference between the work and the total is time spent redrawing the page between steps.</p>
    </details>
}

@if (world.Features.Count > 0)
{
    <section class="card">
        <h3>Geographic features</h3>
        <table>
            <thead><tr><th>Name</th><th>Type</th><th>Scope</th><th>Part of</th><th>Continent</th><th class="num">Blocks</th><th class="num">Pieces</th></tr></thead>
            <tbody>
                @foreach (var f in world.Features)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td>@f.Type.Name</td>
                        <td>@f.Scope</td>
                        <td>@f.Parent?.Name</td>
                        <td>@string.Join(", ", f.Footprint.Blocks.Select(b => b.Status.Continent?.Name).Where(n => n != null).Distinct())</td>
                        <td class="num">@f.Footprint.Count</td>
                        <td class="num">@f.Footprint.Pieces().Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@if (world.Plates.Count > 0)
{
    <section class="card">
        <h3>Tectonic plates</h3>
        <table>
            <thead><tr><th>Name</th><th>Crust</th><th>Drifting</th><th class="num">Blocks</th></tr></thead>
            <tbody>
                @foreach (var p in world.Plates)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@(p.Continental ? "Continental" : "Oceanic")</td>
                        <td>@p.Heading</td>
                        <td class="num">@p.Blocks.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@foreach (var c in world.Continents)
{
    <section class="card">
        <h3>@c.Name <span class="muted">&mdash; @LandBlocks(c) land blocks</span></h3>
        <table>
            <thead><tr><th>Region</th><th>Biome</th><th>Language</th><th class="num">Land blocks</th><th class="num">Areas</th></tr></thead>
            <tbody>
                @foreach (var r in c.Regions)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td>@r.Biome?.Name</td>
                        <td>@r.Language?.LanguageName</td>
                        <td class="num">@r.RegionArea.BlocksList.Count(b => b.Status.WaterStatus != WorldBlockWaterStatus.Water)</td>
                        <td class="num">@r.RegionArea.ContiguousAreas().Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Session.Changed -= OnChanged;

    private string SettingsText
    {
        get
        {
            var settings = Session.Engine.World.GeneratorSettings;
            if (settings.Count == 0) return "defaults";
            var options = Session.OptionsFor(Session.Engine.World.GeneratorId);
            return string.Join(", ", settings.Select(s =>
            {
                var option = options.FirstOrDefault(o => string.Equals(o.Key, s.Key, StringComparison.OrdinalIgnoreCase));
                return option == null ? $"{s.Key} {s.Value}" : $"{option.Name} {option.Format(s.Value)}";
            }));
        }
    }

    private string GeneratorName =>
        Session.Generators.FirstOrDefault(g => g.Id == Session.Engine.World.GeneratorId)?.DisplayName ?? Session.Engine.World.GeneratorId;

    private static string Share(TimeSpan part, TimeSpan whole) =>
        whole.Ticks == 0 ? "" : $"{100.0 * part.Ticks / whole.Ticks:0}%";

    private static int LandBlocks(Continent c) =>
        c.ContinentArea.BlocksList.Count(b => b.Status.WaterStatus == WorldBlockWaterStatus.Land || b.Status.WaterStatus == WorldBlockWaterStatus.Coastline);
}
