@page "/"
@using Worldbuilder.Web.Components
@using Worldbuilder.Web.Services
@using LoreGen.Lang
@implements IDisposable
@inject WorldSession Session

<PageTitle>Worldbuilder</PageTitle>

<header class="topbar">
    <div class="brand">
        <h1>Worldbuilder</h1>
        <span class="muted">LoreGen v0.12</span>
    </div>
    <nav class="tabs main-tabs" role="tablist" aria-label="Sections">
        @foreach (var (key, label) in Sections)
        {
            <button role="tab" aria-selected="@(section == key)" class="@(section == key ? "tab active" : "tab")" @onclick="() => section = key">@label</button>
        }
    </nav>
</header>

@if (section == "worldbuilder")
{
    <form class="seed card" @onsubmit="GenerateFromSeed" @onsubmit:preventDefault>
        <label>Generator
            <select value="@generatorInput" @onchange="OnGeneratorChanged" title="@CurrentDescription">
                @foreach (var g in Session.Generators)
                {
                    <option value="@g.Id" title="@g.Description">@g.DisplayName</option>
                }
            </select>
        </label>
        <label>Names
            <select @bind="languageStyleInput" title="How places are named">
                <option value="@LanguageStyle.Common" title="Names like those in fantasy and historical fiction">Common</option>
                <option value="@LanguageStyle.Phonetic" title="Names built sound by sound from random phonetic rules">Phonetic</option>
            </select>
        </label>
        <label>Seed <input type="number" @bind="seedInput" @bind:event="oninput" /></label>
        <button type="submit" class="btn" disabled="@busy">Generate</button>
        <button type="button" class="btn primary" disabled="@busy" @onclick="GenerateRandom">@(busy ? "Generating…" : "New world")</button>
    </form>

    <details class="options-panel card">
        <summary>Options@(settingsInput.Count > 0 ? $" ({settingsInput.Count} changed)" : "")</summary>
        <OptionsPanel Options="@Session.OptionsFor(generatorInput)" Values="@settingsInput" OnChange="@(() => { })" />
    </details>

    @if (error != null)
    {
        <p class="error" role="alert">@error</p>
    }

    <nav class="tabs sub-tabs" role="tablist" aria-label="World views">
        @foreach (var (key, label) in WorldTabs)
        {
            <button role="tab" aria-selected="@(worldTab == key)" class="@(worldTab == key ? "tab active" : "tab")" @onclick="() => worldTab = key">@label</button>
        }
    </nav>

    <div class="tab-body">
        @switch (worldTab)
        {
            case "map": <MapTab /> break;
            case "info": <InfoTab /> break;
        }
    </div>
}
else
{
    <p class="muted">Tools and reference material that don't depend on the world you've generated.</p>

    <nav class="tabs sub-tabs" role="tablist" aria-label="Reference topics">
        @foreach (var (key, label) in ReferenceTabs)
        {
            <button role="tab" aria-selected="@(referenceTab == key)" class="@(referenceTab == key ? "tab active" : "tab")" @onclick="() => referenceTab = key">@label</button>
        }
    </nav>

    <div class="tab-body">
        @switch (referenceTab)
        {
            case "language": <LanguageTab /> break;
            case "data": <DataTab /> break;
        }
    </div>
}

@code {
    private static readonly (string, string)[] Sections = { ("worldbuilder", "Worldbuilder"), ("reference", "Reference") };
    private static readonly (string, string)[] WorldTabs = { ("map", "Map"), ("info", "World info") };
    private static readonly (string, string)[] ReferenceTabs = { ("language", "Language generator"), ("data", "Raw data") };

    private string section = "worldbuilder";
    private string worldTab = "map";
    private string referenceTab = "language";
    private int seedInput;
    private string generatorInput;
    private Dictionary<string, double> settingsInput = new();
    private LanguageStyle languageStyleInput;
    private bool busy;
    private string error;

    protected override void OnInitialized()
    {
        seedInput = Session.Seed;
        generatorInput = Session.GeneratorId;
        settingsInput = new Dictionary<string, double>(Session.Settings);
        languageStyleInput = Session.LanguageStyle;
        Session.Changed += OnChanged;
    }

    // Options belong to a generator, so switching generator starts them afresh
    private void OnGeneratorChanged(ChangeEventArgs e)
    {
        generatorInput = e.Value?.ToString();
        settingsInput = new Dictionary<string, double>();
    }

    private string CurrentDescription => Session.Generators.FirstOrDefault(g => g.Id == generatorInput)?.Description;

    private void OnChanged()
    {
        seedInput = Session.Seed;
        generatorInput = Session.GeneratorId;
        InvokeAsync(StateHasChanged);
    }

    private Task GenerateFromSeed() => Run(() => Session.Generate(seedInput, generatorInput, settingsInput, languageStyleInput));
    private Task GenerateRandom() => Run(() => Session.GenerateRandom(generatorInput, settingsInput, languageStyleInput));

    private async Task Run(Action generate)
    {
        busy = true;
        StateHasChanged();
        await Task.Delay(30); // let the UI paint the busy state before the (synchronous) generation
        try
        {
            generate();
            error = null;
        }
        catch (Exception ex)
        {
            error = $"World generation failed: {ex.Message} " + (settingsInput.Count > 0 ? "Try different options or another seed." : "Try another seed.");
        }
        busy = false;
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
